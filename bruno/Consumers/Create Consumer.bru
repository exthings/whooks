meta {
  name: Create Consumer
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/consumers
  body: json
  auth: inherit
}

body:json {
  {
    "organization_id": "{{organization_id}}",
    "uid": "{{$randomUUID}}",
    "name": {{$randomCompanyName}},
    "metadata": {
      "group": "Premium"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
