meta {
  name: Create Subscription
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/subscriptions
  body: json
  auth: inherit
}

body:json {
  {
    "endpoint_id": "{{endpoint_id}}",
    "topics":  [
      "transaction.completed",
      "transaction.pending"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
