meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/events
  body: json
  auth: inherit
}

body:json {
  {
    "uid": "script",
    "consumer_id": "{{consumer_id}}",
    "project_id": "{{project_id}}",
    "topic": "transaction.completed",
    "data": {
      "id": "019bb3b7-57f7-7b28-9ad1-ce122c7a66c0",
      "status": "completed",
      "amount": "15"
    },
    "metadata": {
      "transaction_id": "01KESVHY8HACK7HGVYPRP90WS0"
    },
    "tags": ["019bb3b8-198d-7b7d-92af-d6dcb0ee7aad"]
  }
}

script:pre-request {
  const { nanoid } = require("nanoid");
  
  const data = Object.assign(
    req.body,
    {
      uid: nanoid(),
      tags: [nanoid()]
    }
  )
  
  req.setBody(data)
}

settings {
  encodeUrl: true
  timeout: 0
}
