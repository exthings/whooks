meta {
  name: Create Endpoint
  type: http
  seq: 1
}

post {
  url: {{base_url}}/v1/endpoints
  body: json
  auth: inherit
}

body:json {
  {
    "consumer_id": "{{consumer_id}}",
    "project_id": "{{project_id}}",
    "status": "enabled",
    "url": "https://webhook.cool/at/silver-lake-10",
    "description": "Transactions",
    "headers": {
      "x-api-key": "01KESYX8Y3TAR8T6M1R7X4XNB6"
    },
    "subscribe": [
      "transaction.completed",
      "transaction.pending"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
